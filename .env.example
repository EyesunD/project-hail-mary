# Copy to .env and fill in your keys — never commit .env

# Alpaca (paper trading / live)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon.io
POLYGON_API_KEY=

# Tiingo
TIINGO_API_KEY=

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# Data cache
HAILMARY_CACHE_DIR=data/cache
HAILMARY_CACHE_TTL_HOURS=24

# Logging
LOG_LEVEL=INFO
