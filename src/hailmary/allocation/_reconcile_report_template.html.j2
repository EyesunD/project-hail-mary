<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: Inter, system-ui, sans-serif; background: #0d1117; color: #e6edf3;
         margin: 0; padding: 24px; max-width: 1400px; }
  h1, h2, h3 { color: #e6edf3; }
  h1 { margin: 0 0 4px 0; }
  h2 { border-bottom: 1px solid #30363d; padding-bottom: 6px; margin-top: 32px; }
  .meta { color: #8b949e; font-size: 13px; }
  .meta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
               gap: 12px; margin: 16px 0; }
  .meta-card { background: #161b22; border: 1px solid #30363d; border-radius: 6px;
               padding: 10px 14px; }
  .meta-card .label { font-size: 11px; color: #8b949e; text-transform: uppercase; }
  .meta-card .val   { font-size: 16px; font-weight: 600; margin-top: 4px;
                      font-variant-numeric: tabular-nums; color: #e6edf3; }
  .ds-table { border-collapse: collapse; margin-top: 8px; font-size: 12.5px; width: 100%; }
  .ds-table th, .ds-table td { border: 1px solid #30363d; padding: 5px 9px; text-align: right; }
  .ds-table th { background: #161b22; text-align: left; }
  .ds-table td:first-child, .ds-table th:first-child { text-align: left; }
  .ds-table td:nth-child(2), .ds-table th:nth-child(2) { text-align: center; }
  .ds-table td { font-variant-numeric: tabular-nums; }
  .ds-table tbody tr:hover { background: #1f2730; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px;
           font-size: 11px; font-weight: 600; }
  .badge.ok { background: rgba(63, 185, 80, 0.18); color: #3fb950; }
  .badge.noise { background: rgba(210, 153, 34, 0.18); color: #d29922; }
  .badge.warn { background: rgba(248, 81, 73, 0.20); color: #f85149; }
  .badge.muted { background: #21262d; color: #8b949e; }
  .footnote { color: #8b949e; font-size: 12px; max-width: 1100px; line-height: 1.55; }
  .footnote ul { padding-left: 20px; }
  .footnote li { margin-bottom: 6px; }
  .footnote code { background: #161b22; padding: 1px 5px; border-radius: 3px; font-size: 11.5px; }
  .deposits-log td { font-variant-numeric: tabular-nums; }
  .copy-wrap { margin-top: 8px; }
  .copy-btn { background: #161b22; color: #8b949e; border: 1px solid #30363d;
              border-radius: 4px; padding: 3px 9px; font-size: 11px;
              font-family: inherit; cursor: pointer; user-select: none; }
  .copy-btn:hover { background: #1f2730; color: #e6edf3; border-color: #58a6ff; }
  .copy-btn.copied { background: rgba(63, 185, 80, 0.18); color: #3fb950;
                     border-color: #3fb950; }
  details.drill { background: #161b22; border: 1px solid #30363d; border-radius: 6px;
                  padding: 8px 14px; margin: 8px 0; }
  details.drill[open] { padding-bottom: 14px; }
  details.drill summary { cursor: pointer; user-select: none; font-size: 13px;
                          color: #e6edf3; padding: 4px 0; }
  details.drill summary:hover { color: #58a6ff; }
  details.drill summary .pos { color: #3fb950; }
  details.drill summary .neg { color: #f85149; }
  .pos, td.pos, span.pos { color: #3fb950; }
  .neg, td.neg, span.neg { color: #f85149; }
  table.returns-summary { margin: 8px 0 14px; max-width: 760px; }
  table.returns-summary th, table.returns-summary td { padding: 4px 10px; }
  table.returns-summary tr.cumulative-row { border-top: 1px solid #30363d; font-weight: 600; }
  table.returns-summary small { color: #8b949e; font-weight: 400; }
  small.sgd-sub { color: #8b949e; font-weight: 400; font-size: 11px; }
  table.reconcile-table th small { display: block; color: #8b949e; font-weight: 400; font-size: 10px; }
  table.reconcile-table td[data-sort] { text-align: right; font-variant-numeric: tabular-nums; }
  table.reconcile-table td:first-child[data-sort],
  table.reconcile-table td:nth-child(2)[data-sort] { text-align: left; font-variant-numeric: normal; }
  table.sortable th[data-type] { cursor: pointer; user-select: none; position: relative; padding-right: 18px; }
  table.sortable th[data-type]:hover { color: #58a6ff; }
  table.sortable th .sort-arrow::after { content: ''; opacity: 0.4; margin-left: 4px; font-size: 10px; }
  table.sortable th.sort-asc .sort-arrow::after { content: '▲'; opacity: 1; color: #58a6ff; }
  table.sortable th.sort-desc .sort-arrow::after { content: '▼'; opacity: 1; color: #58a6ff; }
  .health-check { margin: 14px 0; padding: 12px 16px; border-radius: 6px;
                  background: #161b22; border-left: 3px solid #30363d; }
  .health-check h3 { margin: 0 0 8px; font-size: 14px; color: #e6edf3; }
  .health-check .health-row { font-size: 12px; color: #c9d1d9; padding: 2px 0; }
  .health-check .lvl-warn { color: #d29922; }
  .health-check .lvl-err  { color: #f85149; }
  .health-check .lvl-ok   { color: #3fb950; }
  .health-check.all-clear { border-left-color: #3fb950; }
  table.multi-anchor-table tfoot tr { border-top: 1px solid #30363d; }
  table.multi-anchor-table tfoot tr.bh-row,
  table.multi-anchor-table tfoot tr.obs-row { font-weight: 600; }
  table.multi-anchor-table tfoot tr.drift-mva-row,
  table.multi-anchor-table tfoot tr.drift-bd-row { color: #8b949e; }
  details.drill summary a.port-link { color: #58a6ff; font-weight: 600;
                                       text-decoration: none; border-bottom: 1px dotted #58a6ff; }
  details.drill summary a.port-link:hover { color: #a371f7; border-bottom-color: #a371f7; }
  details.drill .ds-holdings { margin-top: 10px; width: 100%; max-width: 1300px; }
</style>
</head><body>
<h1>{{ title }}</h1>
<p class="meta">Generated {{ generated_at }}</p>

<div class="meta-grid">
  <div class="meta-card"><div class="label">App Start Snapshot</div>
       <div class="val">{{ start_snapshot_date }}</div></div>
  <div class="meta-card"><div class="label">App End Snapshot</div>
       <div class="val">{{ snapshot_date }}</div></div>
  <div class="meta-card"><div class="label">Reconciliation As-Of</div>
       <div class="val">{{ end_date }}</div></div>
  <div class="meta-card"><div class="label">Deposits Since Start Anchor</div>
       <div class="val">{{ n_deposits }}</div></div>
</div>

{{ health_check | safe }}

<h2>Reconciliation — Performance + Model accuracy</h2>
<p class="footnote">App start and App end both come from the
<code>PortfolioValue</code> sheet. <strong>Δ Perf</strong> = app_end − app_start − deposits
(real performance, deposit-adjusted). <strong>+ Deposits</strong> column is informational —
deposits between the start and end anchor are auto-injected into the BH model at their date
(allocated across the sleeve's holdings at the prevailing target weights), so they are
ALREADY reflected in <strong>Our Model</strong>. <strong>Gap</strong> = our model − app_end
(no separate deposit add — would double-count). Status:
<span class="badge ok">exact</span> &lt; 0.05% &nbsp;
<span class="badge ok">ok</span> &lt; 0.3% &nbsp;
<span class="badge noise">noise</span> &lt; 1% &nbsp;
<span class="badge warn">⚠ investigate</span> ≥ 1%.</p>
{{ reconcile_table | safe }}

<h2>Per-portfolio drill-down — holding-by-holding</h2>
<p class="footnote">Click any portfolio to expand its holdings. For each holding: weight,
stmt value, stmt and today prices (with the actual price-date used — flagged with
<code>*</code> and <code>(+Nd)</code> when forward-accrued because Yahoo lags), return,
today value. <strong>Total row</strong> at the bottom of each sleeve sums to the same
"Total" cell in the reconciliation table above.</p>
{{ drilldown | safe }}

<h2>Deposits log (post start-anchor)</h2>
<p class="footnote">Rows from <code>holding.xlsx</code> &gt; Deposits sheet, filtered to
dates strictly after the start anchor ({{ start_snapshot_date }}). Anything on/before
that date is already in <code>App ({{ start_snapshot_date }})</code> and is not
counted again. Deposits are also auto-injected into the BH/DR model at their date.</p>
{{ deposits_log | safe }}

<h2>Methodology</h2>
<div class="footnote">
{{ methodology | safe }}
</div>

<script>
(function () {
  function tableToTsv(table) {
    var lines = [];
    var headerRows = table.querySelectorAll("thead tr");
    var headerRow = headerRows[headerRows.length - 1];
    if (headerRow) {
      lines.push(Array.prototype.map.call(headerRow.cells, function (c) {
        return c.textContent.trim();
      }).join("\t"));
    }
    var tbody = table.querySelector("tbody");
    if (tbody) {
      Array.prototype.forEach.call(tbody.rows, function (r) {
        lines.push(Array.prototype.map.call(r.cells, function (c) {
          return c.textContent.trim();
        }).join("\t"));
      });
    }
    var foot = table.querySelector("tfoot");
    if (foot) {
      Array.prototype.forEach.call(foot.rows, function (r) {
        lines.push(Array.prototype.map.call(r.cells, function (c) {
          return c.textContent.trim();
        }).join("\t"));
      });
    }
    return lines.join("\n");
  }
  function attach(table) {
    if (table.dataset.copyAttached) return;
    table.dataset.copyAttached = "1";
    var wrap = document.createElement("div");
    wrap.className = "copy-wrap";
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.textContent = "📋 Copy table";
    btn.addEventListener("click", function () {
      var tsv = tableToTsv(table);
      var done = function () {
        btn.textContent = "✓ Copied";
        btn.classList.add("copied");
        setTimeout(function () {
          btn.textContent = "📋 Copy table";
          btn.classList.remove("copied");
        }, 1400);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(tsv).then(done);
      } else {
        var ta = document.createElement("textarea");
        ta.value = tsv;
        document.body.appendChild(ta); ta.select();
        try { document.execCommand("copy"); done(); }
        finally { document.body.removeChild(ta); }
      }
    });
    wrap.appendChild(btn);
    table.parentNode.insertBefore(wrap, table);
  }
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("table.ds-table").forEach(attach);
  });
})();
</script>

<script>
// Sortable tables: click any <th data-type="..."> to sort. Sort key is read
// from each cell's data-sort attribute (set server-side as a raw number for
// numeric columns); falls back to textContent. tfoot rows (TOTAL) are not
// reordered. Re-clicking a sorted column reverses the direction.
(function () {
  function parseKey(cell, type) {
    var raw = cell.getAttribute("data-sort");
    if (raw === null) raw = cell.textContent;
    if (raw === undefined || raw === "" || raw === "—") {
      return type === "num" ? Number.NaN : "";
    }
    if (type === "num" || type === "status") {
      var n = parseFloat(raw);
      return Number.isNaN(n) ? Number.NaN : n;
    }
    return raw.trim().toLowerCase();
  }
  function compare(a, b, type, asc) {
    var av = parseKey(a, type), bv = parseKey(b, type);
    var aNaN = (typeof av === "number" && Number.isNaN(av));
    var bNaN = (typeof bv === "number" && Number.isNaN(bv));
    if (aNaN && bNaN) return 0;
    if (aNaN) return 1;   // empties always last
    if (bNaN) return -1;
    if (av === bv) return 0;
    return (av < bv ? -1 : 1) * (asc ? 1 : -1);
  }
  function sortBy(table, colIdx, type, asc) {
    var tbody = table.querySelector("tbody");
    if (!tbody) return;
    var rows = Array.prototype.slice.call(tbody.rows);
    rows.sort(function (r1, r2) {
      return compare(r1.cells[colIdx], r2.cells[colIdx], type, asc);
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
    // Update arrow indicators
    table.querySelectorAll("thead th").forEach(function (th, i) {
      th.classList.remove("sort-asc", "sort-desc");
      if (i === colIdx) th.classList.add(asc ? "sort-asc" : "sort-desc");
    });
    table.dataset.sortCol = colIdx;
    table.dataset.sortDir = asc ? "asc" : "desc";
  }
  function attachSort(table) {
    if (table.dataset.sortAttached) return;
    table.dataset.sortAttached = "1";
    table.querySelectorAll("thead th[data-type]").forEach(function (th, idx) {
      th.addEventListener("click", function () {
        var currentCol = parseInt(table.dataset.sortCol || "-1", 10);
        var currentDir = table.dataset.sortDir || "desc";
        var asc = (currentCol === idx) ? (currentDir !== "asc") : false;
        sortBy(table, idx, th.dataset.type, asc);
      });
    });
    // Apply default sort if specified
    var defaultCol = parseInt(table.dataset.defaultSort || "-1", 10);
    if (defaultCol >= 0) {
      var th = table.querySelectorAll("thead th")[defaultCol];
      var type = th ? th.dataset.type : "num";
      var asc = (table.dataset.defaultDir || "desc") === "asc";
      sortBy(table, defaultCol, type || "num", asc);
    }
  }
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("table.sortable").forEach(attachSort);
  });
})();
</script>
</body></html>
